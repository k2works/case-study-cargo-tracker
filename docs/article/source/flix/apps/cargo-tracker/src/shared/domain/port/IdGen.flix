///
/// 識別子の生成を表す効果。
///
/// **なぜポートにするか**: 集約は効果を要求しない（[ドメインモデル設計](../../../../../../docs/design/domain-model.md)
/// の集約の実装規約）。したがって `ShipperId` の生成を集約の中では行えない。
/// かといってインターフェース層で生成すると、**識別子の形式という業務の決めごとが
/// 画面の都合と混ざる**。
///
/// 生成を効果として切り出し、アプリケーション層が要求する形にする。
/// テストでは固定値・連番のハンドラへ差し替えられるため、**発行された識別子を
/// 前提にしたアサーションが書ける**。
///
mod SharedIdGen {

    ///
    /// 識別子を生成する効果。
    ///
    /// 返すのは文字列である。UUID か連番かはハンドラの都合であり、
    /// ドメインの関心事ではない。
    ///
    pub eff IdGen {
        def newId(): String
    }
}
