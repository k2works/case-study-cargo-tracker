///
/// SQL を組み立てるときの共通処理（IT8・TS14。IT6 レビュー M6）。
///
/// # なぜ共通化するか
///
/// `escapeLike` が 3 箇所（`JdbcCargoRepo`・`JdbcShipperRepo`・
/// `JdbcShipperExistence`）に同じ実装で複製されていた。
///
/// この関数は**置換の順序を間違えると静かに壊れる**——`\` を最後に回すと、
/// `%` を `\%` へ変えた後の `\` まで二重に打ち消してしまう。
/// 複製したまま片方だけ直すと、**片方の画面でだけワイルドカードが漏れる**。
/// 漏れても検索結果が増えるだけなので、テストが無ければ誰も気付かない。
///
/// **利用者の入力を `LIKE` に載せる場所は今後も増える**。増えるたびに
/// 3 行の置換を書き写す形にしておくと、いずれ順序を取り違える。
///
mod SharedDbSql {

    ///
    /// `LIKE` のメタ文字を打ち消す。
    ///
    /// **`\` を最初に置換する**。後に回すと、`%` を `\%` へ変えた後の `\` まで
    /// 二重に打ち消してしまう。
    ///
    /// SQL 側は `ESCAPE '\'` を明示する必要がある。既定のエスケープ文字は
    /// 処理系によって異なり、**書かないと打ち消しが効かない DB がある**。
    ///
    pub def escapeLike(value: String): String =
        value
            |> String.replace(src = "\\", dst = "\\\\")
            |> String.replace(src = "%", dst = "\\%")
            |> String.replace(src = "_", dst = "\\_")

    ///
    /// 利用者の入力を部分一致のパターンに変える。
    ///
    /// 前後の空白を落とし、小文字に揃え、メタ文字を打ち消して `%` で挟む。
    /// **呼び出し側が 4 つの手順を書き写さずに済む**形にしてある。
    /// SQL 側は `LOWER(列) LIKE ? ESCAPE '\'` と書く。
    ///
    /// 空文字を渡すと `%%`（全件一致）になる。「絞らない」を
    /// 別の条件（`? = ''`）で表す実装は、この値をそのまま渡してよい。
    ///
    pub def likePattern(value: String): String =
        "%" + escapeLike(String.toLowerCase(String.trim(value))) + "%"
}
