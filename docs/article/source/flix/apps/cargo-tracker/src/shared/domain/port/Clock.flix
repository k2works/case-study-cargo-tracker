///
/// 時刻の取得を表す効果。
///
/// **なぜポートにするか**: セッションのタイムアウト・アカウントロックの解除は
/// 「いま何時か」で結果が変わる。実装が `Instant.now()` を直接呼ぶと、
/// **その判定はテストで固定できない**。IT3 では AU-11（ロール別のセッション
/// タイムアウト）が「時刻を注入できない」という理由だけで未検証のまま残った。
///
/// 集約・値オブジェクトは効果を要求しない（現在時刻は引数で受け取る）。
/// 本効果を使うのはアプリケーション層とアダプタ層である。
///
mod SharedClock {

    ///
    /// 現在時刻を取得する効果。
    ///
    /// エポックからのミリ秒だけを返す。`Timestamp` や `Instant` といった
    /// Java の型を返さないのは、**ドメインに近い層へ Java 型を漏らさない**ためである。
    ///
    pub eff Clock {
        def nowMillis(): Int64

        ///
        /// 今日の日付（`YYYY-MM-DD`）。
        ///
        /// **ミリ秒からの変換を呼び出し側に書かせない**。変換にはタイムゾーンの
        /// 判断が要り、各所で書くと「サーバの既定」「UTC」「業務のタイムゾーン」が
        /// 混ざる。ポートは**ドメインが必要とする形**で値を返す。
        ///
        /// 到着期限のような**日単位の業務判断**に使う。時刻を含めて比較すると、
        /// 「期限当日の朝」に期限切れと判定される。
        ///
        def today(): String

        ///
        /// 現在時刻（`YYYY-MM-DDTHH:MM`）。
        ///
        /// **日付だけでは足りない場面がある**（IT12・US19）。
        /// エスカレーションの閾値は 48 時間であり、日付単位で比べると
        /// 「2 日ちょうど」と「2 日 1 時間」を区別できない——
        /// 閾値ちょうどを含めるか否かの議論が入口で無効になる。
        ///
        /// `nowMillis` から導出させないのは、導出にタイムゾーンの解釈が
        /// 要るためである（`today` を分けたのと同じ理由）。
        ///
        def now(): String
    }
}
