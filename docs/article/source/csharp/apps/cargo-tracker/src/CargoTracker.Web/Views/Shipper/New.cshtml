@model CargoTracker.Shipper.Interfaces.ShipperForm
@{
    ViewData["Title"] = "荷主登録";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1 class="h3 mb-3">荷主登録</h1>

        <form asp-action="New" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ShipperType" class="form-label"></label>
                @* 種別変更時に htmx で法人フィールドを動的に差し替える（ui_design） *@
                <div hx-get="/shippers/corporate-fields" hx-target="#corporate-fields" hx-swap="innerHTML"
                     hx-trigger="change" hx-include="[name='ShipperType']">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="ShipperType" id="typeIndividual" value="Individual" />
                        <label class="form-check-label" for="typeIndividual">個人</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="ShipperType" id="typeCorporate" value="Corporate" />
                        <label class="form-check-label" for="typeCorporate">法人</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            @* 法人フィールドは htmx で差し替える。初期表示・バリデーションエラー再表示時は現在の種別に応じて描画する。 *@
            <div id="corporate-fields">
                <partial name="_CorporateFields" model="Model" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">登録する</button>
                <a href="/shippers" class="btn btn-outline-secondary">キャンセル</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
