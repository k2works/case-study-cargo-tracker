@{
    ViewData["Title"] = "貨物追跡";
}

<h1 class="h3 mb-3">貨物追跡</h1>
<p class="text-muted">追跡番号を入力して貨物の現在地・状態・履歴を照会できます。</p>

<form method="get" action="/tracking/lookup" class="col-md-6"
      onsubmit="event.preventDefault(); window.location.href='/tracking/' + encodeURIComponent(document.getElementById('trackingNumber').value.trim());">
    <div class="input-group">
        <input id="trackingNumber" name="trackingNumber" class="form-control" placeholder="TRK-..." />
        <button type="submit" class="btn btn-primary">照会</button>
    </div>
</form>
