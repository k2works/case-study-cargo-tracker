@using CargoTracker.Routing.Application.Internal.QueryServices
@model IReadOnlyList<VoyageSummary>
@{
    ViewData["Title"] = "航路管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">航路管理</h1>
    <a href="/voyages/new" class="btn btn-primary">航海スケジュールを登録</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">登録済みの航海スケジュールはありません。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>航海番号</th>
                    <th>船名</th>
                    <th>運送会社</th>
                    <th>区間</th>
                    <th>期間</th>
                    <th>対応貨物種別</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var voyage in Model)
                {
                    <tr>
                        <td>@voyage.VoyageNumber</td>
                        <td>@voyage.VesselName</td>
                        <td>@voyage.Carrier</td>
                        <td>@voyage.DepartureLocationUnlocode → @voyage.ArrivalLocationUnlocode</td>
                        <td>@voyage.FirstDepartureDate.ToString("yyyy-MM-dd HH:mm") - @voyage.LastArrivalDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@voyage.SupportedCargoTypes</td>
                        <td class="text-end">
                            <a href="/voyages/@voyage.VoyageNumber/edit" class="btn btn-outline-primary btn-sm">更新</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
