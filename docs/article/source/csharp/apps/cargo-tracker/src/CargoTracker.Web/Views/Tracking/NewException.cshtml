@using CargoTracker.Tracking.Interfaces
@model CargoTracker.Tracking.Application.Internal.QueryServices.TrackingDetailView
@{
    ViewData["Title"] = "例外登録";
}

<h1 class="h3 mb-3">例外登録 <span class="text-muted">@Model.TrackingNumber</span></h1>

<p class="text-muted">
    現在のステータス:
    <span class="badge text-bg-secondary">@TransportStatusLabel.ToJapanese(Model.TransportStatus)</span>
    @if (Model.CurrentLocation is not null)
    {
        <span class="ms-2">現在地: @Model.CurrentLocation</span>
    }
</p>

<form method="post" action="/tracking/@Model.TrackingNumber/exceptions" class="mt-3" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="exceptionType" class="form-label">例外種別</label>
        <select id="exceptionType" name="exceptionType" class="form-select" required>
            <option value="Delay">遅延（DELAY）</option>
            <option value="Damage">破損（DAMAGE）</option>
            <option value="Lost">紛失（LOST）</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="locationUnLocode" class="form-label">発生場所（港コード）</label>
        <input id="locationUnLocode" name="locationUnLocode" class="form-control" maxlength="5" placeholder="USLAX" required />
    </div>
    <div class="mb-3">
        <label for="occurredAt" class="form-label">発生日時</label>
        <input id="occurredAt" name="occurredAt" class="form-control" type="datetime-local" required />
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">状況説明</label>
        <textarea id="description" name="description" class="form-control" rows="3" maxlength="500"
                  placeholder="荒天による寄港遅延。到着予定が 3 日遅れる見込み"></textarea>
    </div>

    <div class="alert alert-danger" role="alert">
        ⚠ 例外種別「LOST（紛失）」を選択した場合、管理職へのエスカレーション通知が必須として自動送信されます。
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">登録する</button>
        <a href="/tracking/@Model.TrackingNumber" class="btn btn-outline-secondary">キャンセル</a>
    </div>
</form>
