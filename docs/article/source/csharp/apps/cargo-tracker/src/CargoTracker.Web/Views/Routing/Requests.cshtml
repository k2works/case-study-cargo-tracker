@using CargoTracker.Routing.Application.Internal.QueryServices
@model IReadOnlyList<RoutingRequestSummary>
@{
    ViewData["Title"] = "経路設計依頼";
}

<h1 class="h3 mb-3">経路設計依頼</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">経路設計待ちの予約はありません。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>予約番号</th>
                    <th>区間</th>
                    <th>到着期限</th>
                    <th>貨物種別</th>
                    <th>重量</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.BookingId</td>
                        <td>@request.OriginUnlocode → @request.DestinationUnlocode</td>
                        <td>@request.ArrivalDeadline.ToString("yyyy-MM-dd")</td>
                        <td>@request.CargoType</td>
                        <td>@request.Weight.ToString("0.###") kg</td>
                        <td class="text-end">
                            <a href="/routing/requests/@request.BookingId" class="btn btn-primary btn-sm">検索</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
