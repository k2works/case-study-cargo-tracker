@model CargoTracker.Handling.Interfaces.HandlingListViewModel
@{
    ViewData["Title"] = "荷役作業一覧";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">荷役作業一覧</h1>
    <a href="/handling/new" class="btn btn-primary">荷役作業を登録</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}
@if (TempData["WarningMessage"] is string warning)
{
    <div class="alert alert-warning" role="alert">@warning</div>
}

@if (Model.Activities.Count == 0)
{
    <p class="text-muted">荷役作業の記録はまだありません。</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>予約番号</th>
                    <th>作業種別</th>
                    <th>作業場所</th>
                    <th>航海番号</th>
                    <th>作業日時</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in Model.Activities)
                {
                    <tr>
                        <td>@activity.BookingId</td>
                        <td>@activity.EventType</td>
                        <td>@activity.LocationUnlocode</td>
                        <td>@(activity.VoyageNumber ?? "-")</td>
                        <td>@activity.EventCompletionTime.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
