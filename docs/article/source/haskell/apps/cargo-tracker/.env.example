# Cargo Tracker (Haskell) ローカル開発用環境変数
#
# 使い方: cp .env.example .env して値を埋める。
# .env は .gitignore で無視されるため安全。

# アプリ
APP_ENV=local
PORT=8080
LOG_LEVEL=DEBUG

# データベース (Docker Compose の PostgreSQL)
DATABASE_URL=postgres://cargo_tracker:cargo_tracker_dev@localhost:5432/cargo_tracker_dev?sslmode=disable
POSTGRES_PASSWORD=cargo_tracker_dev

# JWT 署名鍵 (32 文字以上、本番はもっと強い乱数を)
JWT_SECRET=local-development-secret-change-this-in-production-only

# SMTP (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
