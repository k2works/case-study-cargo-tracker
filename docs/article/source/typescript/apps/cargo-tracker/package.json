{
  "name": "@cargo-tracker/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "国際貨物輸送管理システム（NestJS モジュラーモノリス）",
  "scripts": {
    "assets:copy": "node scripts/copy-assets.mjs",
    "prebuild": "npm run assets:copy",
    "build": "tsc -p tsconfig.build.json",
    "predev": "npm run assets:copy",
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "serve": "node --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run assets:copy",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run lint && npm run typecheck && npm run arch",
    "verify": "npm run check && npm run test",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "node --import @swc-node/register/esm-register src/shared/infrastructure/database/seed-cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-flash": "^0.1.1",
    "decimal.js": "^10.4.3",
    "express-session": "^1.18.1",
    "htmx.org": "^2.0.10",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.44.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-flash": "^0.0.40",
    "@types/express-session": "^1.18.0",
    "@types/livereload": "^0.9.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "livereload": "^0.10.3",
    "node-pg-migrate": "^7.0.0",
    "pg-mem": "^3.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
