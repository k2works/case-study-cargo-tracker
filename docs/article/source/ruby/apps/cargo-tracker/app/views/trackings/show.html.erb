<% content_for :title, "追跡詳細" %>
<h1>追跡詳細（<%= @tracking.tracking_number %>）</h1>

<dl class="booking-detail">
  <dt>追跡番号</dt><dd><%= @tracking.tracking_number %></dd>
  <dt>予約番号</dt><dd><%= @tracking.booking_id %></dd>
</dl>

<%# 30 秒ごとに status エンドポイントを再読込して差分更新する（US18） %>
<%= turbo_frame_tag "status_timeline", src: status_tracking_path(@tracking.tracking_number),
      data: { controller: "polling", polling_interval_value: 30_000 } do %>
  <%= render "trackings/status_timeline", tracking: @tracking, events: @events,
        tracking_number: @tracking_number %>
<% end %>

<h2>貨物状態の手動更新（US17）</h2>
<%= form_with url: tracking_status_path(@tracking.tracking_number), method: :patch, local: true, class: "form" do %>
  <div class="field">
    <%= label_tag :transport_status, "新しい状態" %>
    <%= select_tag :transport_status,
          options_for_select(TrackingsController::MANUAL_STATUSES.map { |s| [ tracking_status_label(s), s ] },
                             @tracking.transport_status) %>
  </div>
  <div class="field">
    <%= label_tag :location, "位置（UN/LOCODE・任意）" %>
    <%= text_field_tag :location %>
  </div>
  <div class="field">
    <%= label_tag :event_time, "更新日時（任意）" %>
    <%= datetime_field_tag :event_time %>
  </div>
  <%= submit_tag "状態を更新する", class: "btn btn-primary" %>
<% end %>
