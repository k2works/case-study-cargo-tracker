<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude Spring Boot generated classes -->
    <Match>
        <Class name="~com\.example\.cargotracker\.CargoTrackerApplication"/>
    </Match>

    <!-- Exclude test classes -->
    <Match>
        <Source name="~.*Tests?\.java"/>
    </Match>

    <!-- Exclude Spring configuration classes -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~.*Config"/>
    </Match>

    <!-- Exclude Spring Security lambda DSL false positives -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>
</FindBugsFilter>
