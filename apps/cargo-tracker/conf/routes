# Routes
# 上から順にマッチする。詳細: https://www.playframework.com/documentation/latest/ScalaRouting

# 認証
GET     /login                  cargotracker.auth.interfaces.web.AuthController.loginPage()
POST    /login                  cargotracker.auth.interfaces.web.AuthController.login()
POST    /logout                 cargotracker.auth.interfaces.web.AuthController.logout()

# 荷主
GET     /shippers               cargotracker.shipper.interfaces.web.ShipperController.list()
GET     /shippers/new           cargotracker.shipper.interfaces.web.ShipperController.newForm()
POST    /shippers               cargotracker.shipper.interfaces.web.ShipperController.create()
GET     /shippers/check-email   cargotracker.shipper.interfaces.web.ShipperController.checkEmail(email: String)

# 見積
GET     /estimates              cargotracker.estimation.interfaces.web.EstimateController.list()
GET     /estimates/new          cargotracker.estimation.interfaces.web.EstimateController.newForm()
POST    /estimates              cargotracker.estimation.interfaces.web.EstimateController.create()
GET     /estimates/:estimateId  cargotracker.estimation.interfaces.web.EstimateController.detail(estimateId: String)

# 貨物予約
GET     /bookings               cargotracker.booking.interfaces.web.BookingController.list()
GET     /bookings/new           cargotracker.booking.interfaces.web.BookingController.newForm()
POST    /bookings               cargotracker.booking.interfaces.web.BookingController.create()
GET     /bookings/:bookingId    cargotracker.booking.interfaces.web.BookingController.detail(bookingId: String)
POST    /bookings/:bookingId/assign-routing  cargotracker.booking.interfaces.web.BookingController.assignToRouting(bookingId: String)
POST    /bookings/:bookingId/notify-route    cargotracker.booking.interfaces.web.BookingController.notifyRoute(bookingId: String)
GET     /bookings/:bookingId/notifications   cargotracker.booking.interfaces.web.BookingController.notifications(bookingId: String)
GET     /bookings/:bookingId/routes          cargotracker.routing.interfaces.web.RouteCandidateController.candidates(bookingId: String)
POST    /bookings/:bookingId/routes/:idx/confirm  cargotracker.routing.interfaces.web.RouteCandidateController.confirm(bookingId: String, idx: Int)

# 航海スケジュール（US24・US25）
GET     /voyages                       cargotracker.routing.interfaces.web.VoyageController.list()
GET     /voyages/search                cargotracker.routing.interfaces.web.VoyageController.search()
GET     /voyages/new                   cargotracker.routing.interfaces.web.VoyageController.newForm()
POST    /voyages                       cargotracker.routing.interfaces.web.VoyageController.create()
GET     /voyages/:voyageNumber/edit    cargotracker.routing.interfaces.web.VoyageController.editForm(voyageNumber: String)
POST    /voyages/:voyageNumber/edit    cargotracker.routing.interfaces.web.VoyageController.update(voyageNumber: String)

# ダッシュボード・ヘルス
GET     /                       cargotracker.shared.interfaces.web.HomeController.index()
GET     /health                 cargotracker.shared.interfaces.web.HealthController.health()
