# Routes
# 上から順にマッチする。詳細: https://www.playframework.com/documentation/latest/ScalaRouting

# 認証
GET     /login                  cargotracker.auth.interfaces.web.AuthController.loginPage()
POST    /login                  cargotracker.auth.interfaces.web.AuthController.login()
POST    /logout                 cargotracker.auth.interfaces.web.AuthController.logout()

# 荷主
GET     /shippers               cargotracker.shipper.interfaces.web.ShipperController.list()
GET     /shippers/new           cargotracker.shipper.interfaces.web.ShipperController.newForm()
POST    /shippers               cargotracker.shipper.interfaces.web.ShipperController.create()
GET     /shippers/check-email   cargotracker.shipper.interfaces.web.ShipperController.checkEmail(email: String)

# ダッシュボード・ヘルス
GET     /                       cargotracker.shared.interfaces.web.HomeController.index()
GET     /health                 cargotracker.shared.interfaces.web.HealthController.health()
