<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.booking.infrastructure.persistence.CargoSummaryMapper">

    <resultMap id="cargoSummaryRow"
               type="com.example.cargotracker.booking.infrastructure.persistence.CargoSummaryMapper$CargoSummaryRow">
        <constructor>
            <idArg column="booking_id" javaType="string"/>
            <arg column="booking_number" javaType="string"/>
            <arg column="shipper_id" javaType="string"/>
            <arg column="shipper_name" javaType="string"/>
            <arg column="tracking_number" javaType="string"/>
            <arg column="origin_unlocode" javaType="string"/>
            <arg column="destination_unlocode" javaType="string"/>
            <arg column="arrival_deadline" javaType="java.time.LocalDate"/>
            <arg column="cargo_type" javaType="string"/>
            <arg column="weight_kg" javaType="java.math.BigDecimal"/>
            <arg column="length_cm" javaType="java.math.BigDecimal"/>
            <arg column="width_cm" javaType="java.math.BigDecimal"/>
            <arg column="height_cm" javaType="java.math.BigDecimal"/>
            <arg column="quantity" javaType="_int"/>
            <arg column="product_name" javaType="string"/>
            <arg column="hazard_imo_class" javaType="string"/>
            <arg column="hazard_un_number" javaType="string"/>
            <arg column="temperature_min_c" javaType="java.math.BigDecimal"/>
            <arg column="temperature_max_c" javaType="java.math.BigDecimal"/>
            <arg column="booking_status" javaType="string"/>
            <arg column="routing_status" javaType="string"/>
            <arg column="booked_at" javaType="java.time.Instant"/>
            <arg column="routing_requested_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
            <arg column="updated_by" javaType="string"/>
            <arg column="last_notified_at" javaType="java.time.Instant"/>
            <arg column="returned_to_routing_at" javaType="java.time.Instant"/>
            <arg column="return_reason" javaType="string"/>
            <arg column="route_exclude_unlocodes" javaType="string"/>
            <arg column="route_depart_from_unlocode" javaType="string"/>
            <arg column="confirmed_at" javaType="java.time.Instant"/>
            <arg column="tracking_issued_at" javaType="java.time.Instant"/>
            <arg column="projected_at" javaType="java.time.Instant"/>
            <arg column="last_event_id" javaType="string"/>
        </constructor>
    </resultMap>

    <resultMap id="conditionReviewRow"
               type="com.example.cargotracker.booking.infrastructure.persistence.CargoSummaryMapper$ConditionReviewRow">
        <constructor>
            <idArg column="booking_id" javaType="string"/>
            <arg column="booking_number" javaType="string"/>
            <arg column="reason" javaType="string"/>
            <arg column="requested_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <!-- 見直しを頼まれている予約（S02 / 営業）。古い依頼を上に出す。
         終了した予約は出さない（止めた予約の見直しは要らない）。 -->
    <select id="findConditionReviews" resultMap="conditionReviewRow">
        SELECT booking_id, booking_number,
               condition_review_reason AS reason,
               condition_review_requested_at AS requested_at
        FROM cargo_summary
        WHERE condition_review_requested_at IS NOT NULL
          AND booking_status NOT IN ('SETTLED', 'CANCELLED')
        ORDER BY condition_review_requested_at
        LIMIT #{limit}
    </select>

    <sql id="visible">
        <if test="!includeFinished">
            WHERE booking_status NOT IN ('SETTLED', 'CANCELLED')
        </if>
    </sql>

    <!--
      修正（US32）。付帯情報も含めて丸ごと書き換える。残すと、一般貨物に直したのに
      危険物申告が付いたままの行ができ、経路設計が絞り込みを判断できない。
      状態（booking_status / routing_status）は動かさない。
    -->
    <update id="updateSpecification">
        UPDATE cargo_summary SET
            origin_unlocode = #{originUnlocode},
            destination_unlocode = #{destinationUnlocode},
            arrival_deadline = #{arrivalDeadline},
            cargo_type = #{cargoType},
            weight_kg = #{weightKg},
            length_cm = #{lengthCm},
            width_cm = #{widthCm},
            height_cm = #{heightCm},
            quantity = #{quantity},
            product_name = #{productName},
            hazard_imo_class = #{hazardImoClass},
            hazard_un_number = #{hazardUnNumber},
            temperature_min_c = #{temperatureMinC},
            temperature_max_c = #{temperatureMaxC},
            updated_at = #{updatedAt},
            updated_by = #{updatedBy},
            projected_at = #{projectedAt}
        WHERE booking_id = #{bookingId}
    </update>

    <select id="findById" resultMap="cargoSummaryRow">
        SELECT * FROM cargo_summary WHERE booking_id = #{bookingId}
    </select>

    <!--
      経路設計作業一覧（S30）。**経路設計者がいま設計すべきもの**を出す。
      並び順は誤配が先、そのあと到着期限が近い順。
      並び順を消したら赤になる検査を CargoProjectionIT に置いている。

      絞りは「引き渡された未設計」と「誤配で再設計が要る」の 2 つ。
      booking_status = 'ROUTE_PROPOSED' だけで絞ると、**誤配は 1 件も出ない**。
      誤配になるのは輸送中（IN_TRANSIT 以降）で、そこから ROUTE_PROPOSED へ
      戻る遷移は無いためである。並び順に「誤配が先」と書いてあったので、
      文書・コメント・並び順の 3 つが揃って対応済みに見えていた。

      誤配の再設計は急ぐ仕事で、S30 が唯一の入口である。ここに出ないと
      経路設計者は気づく手段を持たない。
    -->
    <sql id="worklistVisible">
        WHERE (
            booking_status = 'ROUTE_PROPOSED'
            <if test="!includeRouted">
                AND routing_status &lt;&gt; 'ROUTED'
            </if>
            OR routing_status = 'MISROUTED'
        )
    </sql>

    <select id="findRoutingWorklist" resultMap="cargoSummaryRow">
        SELECT * FROM cargo_summary
        <include refid="worklistVisible"/>
        ORDER BY CASE WHEN routing_status = 'MISROUTED' THEN 0 ELSE 1 END,
                 arrival_deadline, booking_number
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countRoutingWorklist" resultType="_int">
        SELECT count(*) FROM cargo_summary
        <include refid="worklistVisible"/>
    </select>

    <select id="findAll" resultMap="cargoSummaryRow">
        SELECT * FROM cargo_summary
        <include refid="visible"/>
        ORDER BY arrival_deadline, booking_number
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="_int">
        SELECT count(*) FROM cargo_summary
        <include refid="visible"/>
    </select>

    <insert id="insert">
        INSERT INTO cargo_summary
            (booking_id, booking_number, shipper_id, shipper_name, tracking_number,
             origin_unlocode, destination_unlocode, arrival_deadline, cargo_type, weight_kg,
             length_cm, width_cm, height_cm, quantity, product_name,
             hazard_imo_class, hazard_un_number, temperature_min_c, temperature_max_c,
             booking_status, routing_status, booked_at, routing_requested_at,
             updated_at, updated_by, projected_at, last_event_id)
        VALUES (#{bookingId}, #{bookingNumber}, #{shipperId}, #{shipperName}, #{trackingNumber},
                #{originUnlocode}, #{destinationUnlocode}, #{arrivalDeadline}, #{cargoType},
                #{weightKg}, #{lengthCm}, #{widthCm}, #{heightCm}, #{quantity}, #{productName},
                #{hazardImoClass}, #{hazardUnNumber}, #{temperatureMinC}, #{temperatureMaxC},
                #{bookingStatus}, #{routingStatus}, #{bookedAt}, #{routingRequestedAt},
                #{updatedAt}, #{updatedBy}, #{projectedAt}, #{lastEventId})
        ON CONFLICT (booking_id) DO NOTHING
    </insert>
</mapper>
