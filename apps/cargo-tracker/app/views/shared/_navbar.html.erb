<%# ロール制御ナビゲーション。ロール別の「作業入口」導線を提供する（ロール別到達性）。 %>
<nav class="navbar" aria-label="メインナビゲーション">
  <span class="navbar-brand"><%= link_to "Cargo Tracker", root_path %></span>

  <% if logged_in? %>
    <ul class="navbar-menu">
      <li><%= link_to "ダッシュボード", root_path %></li>

      <% if current_user.role?(:sales) %>
        <li><%= link_to "荷主登録", new_shipper_path %></li>
        <li><%= link_to "荷主一覧", shippers_path %></li>
        <li><%= link_to "貨物予約", bookings_path %></li>
        <li><%= link_to "見積", estimates_path %></li>
        <li><%= link_to "航路管理", voyages_path %></li>
      <% end %>

      <% if current_user.role?(:tracker) %>
        <li><%= link_to "貨物追跡", tracking_path %></li>
        <li><%= link_to "例外管理", exceptions_path %></li>
      <% end %>

      <% if current_user.role?(:handler) || current_user.role?(:tracker) %>
        <li><%= link_to "荷役管理", handling_events_path %></li>
      <% end %>

      <% if current_user.role?(:billing) %>
        <li><%= link_to "請求管理", billing_invoices_path %></li>
      <% end %>

      <% if current_user.role?(:admin) %>
        <li><%= link_to "管理設定", admin_discount_policies_path %></li>
      <% end %>
    </ul>

    <div class="navbar-user">
      <span class="navbar-username"><%= current_user.username %></span>
      <%= button_to "ログアウト", logout_path, method: :delete, class: "navbar-logout" %>
    </div>
  <% end %>
</nav>
