<% content_for :title, "予約詳細" %>
<h1>予約詳細</h1>

<dl class="booking-detail">
  <dt>予約番号</dt><dd><%= @booking.booking_id %></dd>
  <dt>状態</dt><dd><span class="badge" data-status="<%= @booking.status_value %>"><%= @booking.status_label %></span></dd>
  <dt>荷主 ID</dt><dd><%= @booking.shipper_id %></dd>
  <dt>貨物種別</dt><dd><%= @booking.type_label %></dd>
  <dt>重量</dt><dd><%= @booking.weight_kg %> kg</dd>
  <dt>出発地</dt><dd><%= @booking.origin %></dd>
  <dt>目的地</dt><dd><%= @booking.destination %></dd>
  <dt>希望着日</dt><dd><%= @booking.arrival_deadline %></dd>
  <dt>品名</dt><dd><%= @booking.description %></dd>
</dl>

<% if @booking.routed? %>
  <h2>紐付け経路（旅程）</h2>
  <table class="bookings">
    <thead>
      <tr><th>#</th><th>積地</th><th>揚地</th><th>航海番号</th><th>積込</th><th>荷揚</th></tr>
    </thead>
    <tbody>
      <% @booking.itinerary_legs.each_with_index do |leg, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= leg.load_location %></td>
          <td><%= leg.unload_location %></td>
          <td><%= leg.voyage_number %></td>
          <td><%= leg.load_time&.strftime("%Y-%m-%d") || "-" %></td>
          <td><%= leg.unload_time&.strftime("%Y-%m-%d") || "-" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p>到着予定日時: <%= @booking.expected_arrival_time || "-" %></p>
<% end %>

<div class="booking-actions actions">
  <% if @booking.preliminary? %>
    <%= button_to "経路設計者へ引き渡す", assign_routing_booking_path(@booking.booking_id), method: :post, class: "btn btn-primary" %>
  <% end %>
  <% if @booking.route_requested? %>
    <%= link_to "経路候補を見る（経路割り当て）", edit_booking_route_path(@booking.booking_id), class: "btn btn-primary" %>
  <% end %>
  <% if @booking.route_proposed? %>
    <%= button_to "予約を確定する", confirm_booking_path(@booking.booking_id), method: :post, class: "btn btn-primary" %>
    <%= button_to "ルート変更で差し戻す", reroute_booking_path(@booking.booking_id), method: :post, class: "btn" %>
  <% end %>
  <% unless @booking.confirmed? || @booking.status_value == "CANCELLED" %>
    <%= button_to "予約をキャンセルする", cancel_booking_path(@booking.booking_id), method: :post, class: "btn btn-danger",
                  form: { data: { turbo_confirm: "この予約をキャンセルしますか？" } } %>
  <% end %>
</div>

<h2>通知送信記録（US12/US13）</h2>
<% if @notifications.blank? %>
  <p class="placeholder-note">通知はまだ送信されていません。</p>
<% else %>
  <table class="bookings">
    <thead>
      <tr><th>種別</th><th>宛先</th><th>宛先アドレス</th><th>状態</th><th>送信日時</th></tr>
    </thead>
    <tbody>
      <% @notifications.each do |n| %>
        <tr>
          <td><%= n.event_type %></td>
          <td><%= n.recipient_type %></td>
          <td><%= n.recipient_address %></td>
          <td><span class="badge"><%= n.status %></span></td>
          <td><%= n.sent_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p><%= link_to "貨物予約一覧へ", bookings_path %></p>
