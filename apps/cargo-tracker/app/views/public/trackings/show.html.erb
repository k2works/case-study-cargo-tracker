<% content_for :title, "貨物追跡結果" %>
<h1>貨物追跡結果</h1>

<% if @tracking.nil? %>
  <p class="alert alert-warning">追跡番号 <%= @tracking_number %> は見つかりません。番号をご確認ください。</p>
  <%= link_to "追跡番号を入力し直す", public_tracking_path, class: "btn btn-secondary" %>
<% else %>
  <dl class="booking-detail">
    <dt>追跡番号</dt><dd><%= @tracking.tracking_number %></dd>
    <dt>現在の状態</dt>
    <dd>
      <span class="badge <%= "badge-danger" if @tracking.transport_status == "EXCEPTION" %>">
        <%= tracking_status_label(@tracking.transport_status) %>
      </span>
    </dd>
    <dt>現在地</dt><dd><%= @last_event&.dig(:location) || "-" %></dd>
    <dt>最終更新</dt><dd><%= @last_event&.dig(:event_time)&.strftime("%Y-%m-%d %H:%M") || "-" %></dd>
  </dl>
  <p class="placeholder-note">状態の反映には最大 30 秒程度かかる場合があります。</p>
  <%= link_to "別の貨物を追跡する", public_tracking_path, class: "btn btn-secondary" %>
<% end %>
