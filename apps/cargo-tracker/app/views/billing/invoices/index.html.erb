<% content_for :title, "請求書一覧" %>
<h1>請求書一覧</h1>
<p class="lead">発行済みの請求書と精算状況（US21/US23）。</p>

<%= form_with url: billing_invoices_path, method: :post, local: true, class: "inline-form" do %>
  <%= label_tag :booking_id, "料金算出（引取済予約番号）" %>
  <%= text_field_tag :booking_id, nil, placeholder: "BKG-XXXXXXXX", required: true %>
  <%= submit_tag "料金を算出する", class: "btn btn-primary" %>
<% end %>

<% if @invoices.empty? %>
  <p class="placeholder-note">請求書の記録がありません。</p>
<% else %>
  <table class="bookings">
    <thead>
      <tr><th>請求番号</th><th>予約番号</th><th>請求金額</th><th>支払期限</th><th>状態</th></tr>
    </thead>
    <tbody>
      <% @invoices.each do |i| %>
        <tr>
          <td><%= link_to i.invoice_number, billing_invoice_path(i.invoice_number) %></td>
          <td><%= i.booking_id %></td>
          <td><%= number_to_currency(i.total_amount, unit: "¥", precision: 0) %></td>
          <td><%= i.due_date&.strftime("%Y-%m-%d") %></td>
          <td><span class="badge"><%= payment_status_label(i.payment_status) %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
