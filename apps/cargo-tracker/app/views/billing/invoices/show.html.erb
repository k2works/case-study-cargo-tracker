<% content_for :title, "請求書詳細" %>
<h1>請求書詳細（<%= @invoice.invoice_number %>）</h1>

<dl class="booking-detail">
  <dt>請求番号</dt><dd><%= @invoice.invoice_number %></dd>
  <dt>予約番号</dt><dd><%= @invoice.booking_id %></dd>
  <dt>発行日</dt><dd><%= @invoice.issued_at&.strftime("%Y-%m-%d") %></dd>
  <dt>支払期限</dt><dd><%= @invoice.due_date&.strftime("%Y-%m-%d") %></dd>
  <dt>状態</dt><dd><span class="badge"><%= payment_status_label(@invoice.payment_status) %></span></dd>
</dl>

<h2>料金明細</h2>
<table class="bookings">
  <tbody>
    <tr><th>基本料金</th><td><%= number_to_currency(@invoice.base_amount, unit: "¥", precision: 0) %></td></tr>
    <% if @invoice.discount_percentage.positive? %>
      <tr>
        <th>割引（<%= @invoice.discount_percentage %>%）</th>
        <td>- <%= number_to_currency(@invoice.discount_amount, unit: "¥", precision: 0) %></td>
      </tr>
    <% end %>
    <tr><th>燃油サーチャージ（5%）</th><td>+ <%= number_to_currency(@invoice.surcharge_amount, unit: "¥", precision: 0) %></td></tr>
    <tr>
      <th>小計（課税対象額）</th>
      <td><%= number_to_currency(@invoice.total_amount - @invoice.tax_amount, unit: "¥", precision: 0) %></td>
    </tr>
    <tr><th>消費税（10%）</th><td><%= number_to_currency(@invoice.tax_amount, unit: "¥", precision: 0) %></td></tr>
    <tr><th>請求金額（合計）</th><td><strong><%= number_to_currency(@invoice.total_amount, unit: "¥", precision: 0) %></strong></td></tr>
  </tbody>
</table>
<p class="placeholder-note">
  割引根拠: 基本料金 <%= number_to_currency(@invoice.base_amount, unit: "¥", precision: 0) %> ×
  割引率 <%= @invoice.discount_percentage %>% =
  割引後 <%= number_to_currency(@invoice.base_amount - @invoice.discount_amount, unit: "¥", precision: 0) %>
</p>

<% if @invoice.line_items.any? %>
  <h2>料金調整明細（US21-6）</h2>
  <table class="bookings">
    <thead><tr><th>種別</th><th>説明</th><th>金額</th><th>担当者</th><th>日時</th><th>理由</th><th>操作</th></tr></thead>
    <tbody>
      <% @invoice.line_items.each do |li| %>
        <tr>
          <td><%= li.adjustment_type == "REDUCTION" ? "減額" : "補償費用" %></td>
          <td><%= li.description %></td>
          <td><%= number_to_currency(li.amount, unit: "¥", precision: 0) %></td>
          <td><%= li.adjusted_by || "-" %></td>
          <td><%= li.adjusted_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
          <td><%= li.reason || "-" %></td>
          <td>
            <% if @invoice.cancellable %>
              <%= form_with url: cancel_adjustment_billing_invoice_path(@invoice.invoice_number), method: :post, local: true, class: "inline-form" do %>
                <%= hidden_field_tag :seq_number, li.seq_number %>
                <%= submit_tag "取消", class: "btn btn-sm", data: { turbo_confirm: "この調整を取り消しますか？" } %>
              <% end %>
            <% else %>
              -
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @invoice.payment_status == "PENDING" %>
  <h2>料金調整を追加（例外時の減額・補償費用・US21-6）</h2>
  <%= form_with url: adjust_billing_invoice_path(@invoice.invoice_number), method: :post, local: true, class: "form" do %>
    <div class="field">
      <%= label_tag :adjustment_type, "種別" %>
      <%= select_tag :adjustment_type, options_for_select([ [ "減額", "REDUCTION" ], [ "補償費用", "COMPENSATION" ] ]) %>
      <p class="placeholder-note">種別は会計分類用です。金額への効果はどちらも請求額の減算です（補償費用は当社負担）。</p>
    </div>
    <div class="field">
      <%= label_tag :description, "理由" %>
      <%= text_field_tag :description, nil, required: true, placeholder: "遅延による減額 / 破損補償費用 等" %>
    </div>
    <div class="field">
      <%= label_tag :amount, "金額（円・絶対値。減額・補償費用とも請求額から減算されます）" %>
      <%= number_field_tag :amount, nil, required: true, min: 1 %>
    </div>
    <div class="field">
      <%= label_tag :reason, "理由（監査証跡）" %>
      <%= text_field_tag :reason, nil, placeholder: "台風遅延の補填・破損補償 等" %>
    </div>
    <%= submit_tag "料金調整を追加する", class: "btn btn-secondary" %>
  <% end %>

  <%= form_with url: confirm_billing_invoice_path(@invoice.invoice_number), method: :post, local: true do %>
    <%= submit_tag "入金を確認する", class: "btn btn-primary",
          data: { turbo_confirm: "入金を確認して精算を完了しますか？" } %>
  <% end %>
<% elsif @invoice.payment_status == "CONFIRMED" %>
  <p class="alert alert-success">入金確認済み（精算完了）。入金日: <%= @invoice.paid_at&.strftime("%Y-%m-%d") %></p>
<% end %>

<%= link_to "一覧へ戻る", billing_invoices_path, class: "btn btn-secondary" %>
