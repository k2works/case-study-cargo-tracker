<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 名前空間ルートは CargoTracker（architecture_backend.md プロジェクト構造） -->
    <RootNamespace>CargoTracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- DbUp マイグレーションスクリプト（埋め込みリソース。ADR-0003 プロバイダ別） -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
  </ItemGroup>

</Project>
