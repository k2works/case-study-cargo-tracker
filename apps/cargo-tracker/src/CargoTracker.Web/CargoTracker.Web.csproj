<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 名前空間ルートは CargoTracker（architecture_backend.md プロジェクト構造） -->
    <RootNamespace>CargoTracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- DbUp マイグレーションスクリプト（埋め込みリソース。ADR-0003 プロバイダ別） -->
    <EmbeddedResource Include="Scripts\**\*.sql" />
  </ItemGroup>

  <Target Name="CopyClientLibraries" BeforeTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\..\..\node_modules')">
    <ItemGroup>
      <BootstrapClientLibrary Include="$(MSBuildProjectDirectory)\..\..\..\..\node_modules\bootstrap\dist\**\*.*" />
      <JQueryClientLibrary Include="$(MSBuildProjectDirectory)\..\..\..\..\node_modules\jquery\dist\**\*.*" />
      <JQueryValidationClientLibrary Include="$(MSBuildProjectDirectory)\..\..\..\..\node_modules\jquery-validation\dist\**\*.*" />
      <JQueryValidationUnobtrusiveClientLibrary Include="$(MSBuildProjectDirectory)\..\..\..\..\node_modules\jquery-validation-unobtrusive\dist\**\*.*" />
      <HtmxClientLibrary Include="$(MSBuildProjectDirectory)\..\..\..\..\node_modules\htmx.org\dist\htmx.min.js" />
    </ItemGroup>

    <Copy SourceFiles="@(BootstrapClientLibrary)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\lib\bootstrap\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(JQueryClientLibrary)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\lib\jquery\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(JQueryValidationClientLibrary)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\lib\jquery-validation\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(JQueryValidationUnobtrusiveClientLibrary)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\lib\jquery-validation-unobtrusive\dist\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HtmxClientLibrary)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\lib\htmx\dist\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
