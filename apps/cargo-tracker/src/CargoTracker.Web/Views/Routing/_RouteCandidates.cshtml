@model CargoTracker.Routing.Interfaces.RouteCandidatesViewModel

@if (Model.Candidates.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        期限内に到達可能な経路がありません。出発期間や港などの条件を調整してください。
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>推奨順</th>
                    <th>区分</th>
                    <th>航海番号</th>
                    <th>経由港</th>
                    <th>所要日数</th>
                    <th>費用（概算・円）</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var rank = 1;
                }
                @foreach (var candidate in Model.Candidates)
                {
                    var index = rank - 1;
                    <tr>
                        <td>@rank</td>
                        <td>
                            @if (candidate.IsDirect)
                            {
                                <span class="badge bg-success">直行</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">乗継 @candidate.TransferCount 回</span>
                            }
                        </td>
                        <td>@string.Join(" → ", candidate.VoyageNumbers.Select(v => v.Value))</td>
                        <td>@string.Join(" → ", candidate.Ports.Select(p => p.UnLocode))</td>
                        <td>@candidate.TransitDays 日</td>
                        <td>約 @candidate.Cost.ToString("N0") 円</td>
                        <td>
                            <form method="post" action="/routing/requests/@Model.BookingId/select" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="OriginUnlocode" value="@Model.Form.OriginUnlocode" />
                                <input type="hidden" name="DestinationUnlocode" value="@Model.Form.DestinationUnlocode" />
                                <input type="hidden" name="DepartureFrom" value="@Model.Form.DepartureFrom.ToString("yyyy-MM-ddTHH:mm")" />
                                <input type="hidden" name="DepartureTo" value="@Model.Form.DepartureTo.ToString("yyyy-MM-ddTHH:mm")" />
                                <input type="hidden" name="CargoType" value="@Model.Form.CargoType" />
                                <input type="hidden" name="routeKey" value="@string.Join("-", candidate.VoyageNumbers.Select(v => v.Value))" />
                                <input type="hidden" name="selectedIndex" value="@index" />
                                <button type="submit" class="btn btn-sm btn-primary">この経路を選択・確定</button>
                            </form>
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mb-0">
        費用・所要日数は概算です。最適な候補がない場合は検索条件を調整して再算出してください（US10）。
    </p>
}
