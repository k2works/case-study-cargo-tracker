<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CargoTracker.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CargoTracker.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/"><strong>CargoTracker</strong></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link text-dark" href="/">ダッシュボード</a></li>
                            @if (User.IsInRole(Roles.Sales))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/bookings">貨物予約</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" href="/shippers">荷主管理</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" href="/estimates">見積管理</a></li>
                            }
                            @if (User.IsInRole(Roles.Tracker))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/tracking">貨物追跡</a></li>
                            }
                            @if (User.IsInRole(Roles.Handler) || User.IsInRole(Roles.Tracker))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/handling">荷役管理</a></li>
                            }
                            @if (User.IsInRole(Roles.RouteDesigner))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/voyages">航路管理</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" href="/routing/requests">経路設計</a></li>
                            }
                            @if (User.IsInRole(Roles.Billing))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/billing/invoices">請求管理</a></li>
                            }
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" href="/admin/discount-policies">管理設定</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center me-2 text-muted">@User.Identity?.Name</li>
                            <li class="nav-item">
                                <form action="/logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link text-dark">ログアウト</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CargoTracker.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/dist/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
