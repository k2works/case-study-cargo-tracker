///
/// 開発用サンプルデータの投入。
///
/// **業務データのシードをマイグレーションに置かない**のは、テストが自前で用意する
/// データと衝突するためである（IT1 で実際に一意制約違反が発生した）。
/// マイグレーションに置くのはマスタデータ（`location`）までとし、
/// 業務データは開発起動時にのみ投入する。
///
mod SharedDbDevSeed {
    import java.sql.Connection
    use SharedBcryptPassword.withBcryptPassword
    use SharedDbPool.DataSource
    use SharedDbPool.{withConnection, withStatement, withPreparedStatement}
    use SharedPassword.Password

    ///
    /// 開発用の利用者を投入する（冪等）。
    ///
    /// パスワードは起動のたびにハッシュ化する。ハッシュをソースへ書くと、
    /// コスト設定を変えたときに開発環境だけ古い設定のまま残る。
    ///
    /// **本パスワードは開発用である**。本番の利用者は運用手順で登録する。
    ///
    pub def seedUsers(ds: DataSource): Unit \ IO =
        let hash = withBcryptPassword(() -> Password.hash("password"));
        withConnection(ds, conn -> {
            insertUser(conn, hash, 1i64, "yamada", "yamada@example.com", "ROLE_SALES");
            insertUser(conn, hash, 2i64, "admin", "admin@example.com", "ROLE_ADMIN");
            // 荷役作業員（IT11・E2E シナリオ③）。**開発環境に居ないロールは
            // 画面を確かめられない**——荷役の導線は IT10 で入ったが、
            // 開発用シードに該当ロールが 1 人も居なかった
            insertUser(conn, hash, 3i64, "sato", "sato@example.com", "ROLE_HANDLER");
            // 追跡管理者（IT12・US19）。**開発環境に居ないロールは画面を
            // 確かめられない**——例外の入口は追跡管理者にしか無い
            insertUser(conn, hash, 4i64, "watanabe", "watanabe@example.com",
                       "ROLE_TRACKER")
        })

    /// 利用者 1 名を投入する（ハッシュは変数のためプレースホルダで渡す。arch-lint 規約 9）
    def insertUser(conn: Connection, hash: String, id: Int64,
                   name: String, email: String, roleValue: String): Unit \ IO =
        withPreparedStatement(conn, insertUserSql(), stmt -> {
            stmt.setLong(1, id);
            stmt.setString(2, name);
            stmt.setString(3, email);
            stmt.setString(4, hash);
            // `WHERE NOT EXISTS` の照合に使う 5 番目のプレースホルダ
            stmt.setString(5, name);
            discard stmt.executeUpdate()
        });
        withPreparedStatement(conn, insertRoleSql(), stmt -> {
            stmt.setLong(1, id);
            stmt.setString(2, roleValue);
            stmt.setLong(3, id);
            discard stmt.executeUpdate()
        })

    /// 利用者の投入（冪等）
    def insertUserSql(): String =
        "INSERT INTO users (id, username, email, password, enabled) " +
        "SELECT ?, ?, ?, ?, TRUE WHERE NOT EXISTS " +
        "(SELECT 1 FROM users existing WHERE existing.username = ?)"

    /// ロールの投入（冪等）
    def insertRoleSql(): String =
        "INSERT INTO user_roles (user_id, role) SELECT ?, ? WHERE NOT EXISTS " +
        "(SELECT 1 FROM user_roles existing WHERE existing.user_id = ?)"

    /// サンプルの追跡データを投入する（冪等）
    pub def seed(ds: DataSource): Unit \ IO =
        withConnection(ds, conn -> withStatement(conn, stmt -> {
        discard stmt.executeUpdate(
            "INSERT INTO tracking_activity " +
            // **主キーを明示しない**（IT11）。`GENERATED BY DEFAULT AS IDENTITY` は
            // 明示した値で採番列を進めないため、次に採番される値が 1 に戻り、
            // **利用者が追跡番号を発行した瞬間に主キー衝突で失敗する**。
            // E2E が予約の登録で落ちて初めて分かった
            "(tracking_number, booking_id, transport_status, estimated_arrival) " +
            "SELECT 'TRK-20260803-0001', 'BK-0001', 'ONBOARD_CARRIER', " +
            "TIMESTAMP '2026-08-10 00:00:00' WHERE NOT EXISTS " +
            "(SELECT 1 FROM tracking_activity existing " +
            "WHERE existing.tracking_number = 'TRK-20260803-0001')");
        // **追跡番号に対応する貨物も入れる**（IT11・E2E シナリオ③が暴いた）。
        // IT10 までは `tracking_activity` だけを入れており、**荷役の登録が
        // 「その追跡番号は登録されていません」で必ず失敗する**状態だった——
        // 荷役は追跡番号から `cargo` を引いて予定の経路と突き合わせるためである。
        // 開発環境を開いた人が最初に触る貨物で業務が回らないのは、
        // 「機能は入っているのに業務が回らない」の縮小版である。
        discard stmt.executeUpdate(
            "INSERT INTO cargo " +
            "(booking_id, shipper_id, cargo_type, weight, origin_unlocode, " +
            " destination_unlocode, arrival_deadline, booking_status, tracking_number) " +
            "SELECT 'BK-0001', 'SHP-DEV0001', 'GENERAL', 1200, 'JPTYO', " +
            "'USLAX', DATE '2026-08-31', 'TRACKING_ISSUED', 'TRK-20260803-0001' " +
            "WHERE NOT EXISTS (SELECT 1 FROM cargo existing " +
            "WHERE existing.booking_id = 'BK-0001')");
        // 予定の経路（東京 → ロサンゼルス）。**荷降しの妥当性判定に要る**——
        // 旅程が無いと「経路が無い」として警告になり、判定を確かめられない
        discard stmt.executeUpdate(
            "INSERT INTO leg " +
            "(cargo_id, voyage_number, load_location_unlocode, " +
            " unload_location_unlocode, load_time, unload_time, seq_number) " +
            "SELECT c.id, 'V-0002S', 'JPTYO', 'USLAX', " +
            "TIMESTAMP '2026-08-03 09:15:00', TIMESTAMP '2026-08-10 08:00:00', 1 " +
            "FROM cargo c WHERE c.booking_id = 'BK-0001' " +
            "AND NOT EXISTS (SELECT 1 FROM leg existing WHERE existing.cargo_id = c.id)");
        // 追跡活動は業務キー（追跡番号）で引く。**サロゲートキーを直書きしない**
        discard stmt.executeUpdate(
            "DELETE FROM tracking_handling_event WHERE tracking_id IN " +
            "(SELECT id FROM tracking_activity WHERE tracking_number = 'TRK-20260803-0001')");
        discard stmt.executeUpdate(
            "INSERT INTO tracking_handling_event " +
            "(tracking_id, event_type, event_time, location_unlocode, voyage_number) " +
            "SELECT a.id, 'RECEIVE', TIMESTAMP '2026-08-02 14:00:00', 'JPTYO', NULL " +
            "FROM tracking_activity a WHERE a.tracking_number = 'TRK-20260803-0001'");
        discard stmt.executeUpdate(
            "INSERT INTO tracking_handling_event " +
            "(tracking_id, event_type, event_time, location_unlocode, voyage_number) " +
            "SELECT a.id, 'LOAD', TIMESTAMP '2026-08-03 09:15:00', 'JPTYO', 'V-0002S' " +
            "FROM tracking_activity a WHERE a.tracking_number = 'TRK-20260803-0001'")
        }))
}
