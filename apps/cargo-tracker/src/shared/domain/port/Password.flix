///
/// パスワードのハッシュ化と検証（ポート）。
///
/// 効果として宣言することで、**平文パスワードを扱うコードがこの効果を要求する**ことが
/// 型に現れる。ハッシュアルゴリズムの実体はハンドラ側に閉じ、アプリケーション層は
/// BCrypt であることを知らない。
///
/// [非機能要件](../../../../../../docs/design/non_functional.md) 4.1 のパスワードポリシーに従う。
///
mod SharedPassword {

    ///
    /// パスワード効果。
    ///
    /// `verify` が `Bool` を返すのは、「一致しない」がエラーではなく通常の分岐だからである。
    /// 例外にすると、呼び出し側が握り潰したときに認証を素通りさせる形になりうる。
    ///
    pub eff Password {
        /// 平文とハッシュが一致するか検証する
        def verify(plain: String, hashed: String): Bool

        /// 平文をハッシュ化する
        def hash(plain: String): String
    }
}
