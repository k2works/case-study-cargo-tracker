///
/// 取扱可能な場所（港）の参照。
///
/// **なぜポートにするか**: 出発地・目的地は `location` マスタへの外部キーであり、
/// マスタに無いコードを保存しようとすると**外部キー違反で応答が返らない**
/// （トランザクションは例外を捕捉せず、HTTP ハンドラにも catch がない）。
/// IT4 のレビューで、荷主 ID は ACL で丁寧に守っているのに港コードは素通りしている
/// 非対称が指摘された。
///
/// `location` は共有カーネル（[ドメインモデル設計](../../../../../../docs/design/domain-model.md)）
/// であり特定の BC のものではないため、`shared/domain/port` に置く。
///
mod SharedLocationCatalog {

    ///
    /// 取扱可能な場所の一覧と存在確認。
    ///
    /// 一覧を返せるようにするのは、**利用者に選ばせる**ためである。
    /// UN/LOCODE の暗記を求めるのは業務の要求ではない。
    ///
    pub eff LocationCatalog {
        /// 取扱可能な場所（UN/LOCODE と名称）を一覧する
        def all(): List[(String, String)]
    }
}
