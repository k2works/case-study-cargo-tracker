# CargoTracker 本番環境変数テンプレート。
# cp .env.production.example .env.production して値を設定し、リポジトリにはコミットしないこと。

# --- PostgreSQL ---
POSTGRES_USER=cargo_tracker
POSTGRES_DB=cargo_tracker
# 必須: 強力なパスワードを設定する
POSTGRES_PASSWORD=change_me_strong_password

# --- アプリケーション ---
# ホスト側の公開ポート（アプリは内部 8080）
APP_PORT=8080

# 管理者ブートストラップ（users が空のとき 1 件だけ作成される）。初回ログイン後に変更すること。
ADMIN_USERNAME=admin
# 必須: 強力なパスワードを設定する
ADMIN_PASSWORD=change_me_admin_password
