<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  検査を実際に落とす（ignoreFailures = false）にあたって、構造的に成り立たない指摘だけを外す。

  「いま出ているから外す」形にはしない。それは基準を実装に合わせることであり、
  抑制した瞬間に負債が見えなくなる。ここに並ぶのは、規則の前提がこのコードベースに
  当てはまらないものだけである。
-->
<suppressions>
    <!--
      Spring Boot の起動クラスは main しか持たないため、ユーティリティクラスに見える。
      だがコンストラクタを private にすると Spring がインスタンス化できず起動しない。
    -->
    <suppress checks="HideUtilityClassConstructor" files=".*Application\.java$"/>

    <!--
      テストのメソッド名は日本語で書く。何を確かめているかは、テストの唯一の説明である。
      識別子の規約を優先して英語に直すと、失敗したときに読めるものが減る。
    -->
    <suppress checks="MethodName" files="[\\/]src[\\/]test[\\/]"/>

    <!--
      log は定数ではなくロガーである。ConstantName が static final を一律に定数と見なすため
      当たるが、業界の慣習は小文字の log であり、こちらを直すと読みにくくなる。
    -->
    <suppress checks="ConstantName" files=".*\.java$" message="^名前 'log'"/>
</suppressions>
