<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.billingms.infrastructure.repositories.mybatis.PaymentMapper">

    <resultMap id="paymentResultMap" type="com.example.billingms.domain.projections.Payment">
        <id property="paymentId" column="payment_id"/>
        <result property="invoiceId" column="invoice_id"/>
        <result property="paidAmount" column="paid_amount"/>
        <result property="currency" column="currency"/>
        <result property="paidAt" column="paid_at"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="externalReference" column="external_reference"/>
    </resultMap>

    <insert id="insertPayment">
        INSERT INTO payment (
            payment_id,
            invoice_id,
            paid_amount,
            currency,
            paid_at,
            payment_method,
            external_reference
        ) VALUES (
            #{paymentId},
            #{invoiceId},
            #{paidAmount},
            #{currency},
            #{paidAt},
            #{paymentMethod},
            #{externalReference}
        )
    </insert>

    <select id="findByInvoiceId" resultMap="paymentResultMap">
        SELECT * FROM payment
        WHERE invoice_id = #{invoiceId}
        ORDER BY paid_at
    </select>

</mapper>
