<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionMapper">

    <resultMap id="trackingExceptionResultMap"
               type="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionRecord">
        <id property="exceptionId" column="exception_id"/>
        <result property="trackingNumber" column="tracking_number"/>
        <result property="exceptionType" column="exception_type"/>
        <result property="occurredAt" column="occurred_at"/>
        <result property="occurredUnlocode" column="occurred_unlocode"/>
        <result property="description" column="description"/>
        <result property="responseStatus" column="response_status"/>
        <result property="resolution" column="resolution"/>
        <result property="resolvedAt" column="resolved_at"/>
        <result property="escalated" column="escalated"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.example.cargotracker.trackingms.infrastructure.persistence.TrackingExceptionRecord">
        INSERT INTO tracking_exception (
            exception_id, tracking_number, exception_type, occurred_at,
            occurred_unlocode, description, response_status, resolution,
            resolved_at, escalated
        ) VALUES (
            #{exceptionId}, #{trackingNumber}, #{exceptionType}, #{occurredAt},
            #{occurredUnlocode}, #{description}, #{responseStatus}, #{resolution},
            #{resolvedAt}, #{escalated}
        )
    </insert>

    <select id="findByTrackingNumber" resultMap="trackingExceptionResultMap">
        SELECT * FROM tracking_exception
        WHERE tracking_number = #{trackingNumber}
        ORDER BY occurred_at DESC
    </select>

</mapper>
