<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.trackingms.infrastructure.repositories.mybatis.TrackingSummaryMapper">

    <resultMap id="trackingSummaryResultMap" type="com.example.trackingms.domain.projections.TrackingSummary">
        <id property="trackingNumber" column="tracking_number"/>
        <result property="bookingId" column="booking_id"/>
        <result property="currentStatus" column="current_status"/>
        <result property="currentUnlocode" column="current_unlocode"/>
        <result property="currentVoyageNumber" column="current_voyage_number"/>
        <result property="estimatedArrival" column="estimated_arrival"/>
        <result property="misrouted" column="misrouted"/>
        <result property="lastEventAt" column="last_event_at"/>
        <result property="deliveredAt" column="delivered_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="version" column="version"/>
    </resultMap>

    <insert id="insertTrackingSummary">
        INSERT INTO tracking_summary (
            tracking_number,
            booking_id,
            current_status,
            misrouted,
            last_event_at,
            created_at,
            updated_at,
            version
        ) VALUES (
            #{trackingNumber},
            #{bookingId},
            #{currentStatus},
            FALSE,
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP,
            0
        )
    </insert>

    <select id="findByTrackingNumber" resultMap="trackingSummaryResultMap">
        SELECT *
        FROM tracking_summary
        WHERE tracking_number = #{trackingNumber}
    </select>

    <select id="findByBookingId" resultMap="trackingSummaryResultMap">
        SELECT *
        FROM tracking_summary
        WHERE booking_id = #{bookingId}
    </select>

</mapper>
