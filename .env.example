# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# MkDocs サーバー設定
MKDOCS_PORT=8000

# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# DOCKER_HOST=npipe:////./pipe/docker_engine

# SSH 接続設定
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx

# 開発環境デプロイ設定（Heroku Container Registry）
# Heroku アプリ名（deploy:dev:* タスクで必須）
DEV_HEROKU_APP_NAME=xxxxxxxx
# Heroku Container Runtime は x86_64 のみ対応。Apple Silicon でも linux/amd64 でビルドする
DEV_DOCKER_PLATFORM=linux/amd64
# ドキュメントサイト（docs / JIG / jig-erd / manual）の Heroku アプリ名
DOCS_HEROKU_APP_NAME=xxxxxxxx

# アプリケーションタスク設定
# APP_DIR=apps/cargo-tracker
# APP_PROFILE=local
# APP_PORT=8080
# ADMINER_PORT=8081

# ユーザーマニュアル生成設定（gulp manual:build）
# サイトタイトル（未設定時は「ユーザーマニュアル」）
# MANUAL_TITLE=国際貨物輸送管理システム ユーザーマニュアル
# フッターの著作権表示（未設定時は出力しない）
# MANUAL_COPYRIGHT=
# 上位ポータルへの戻り先（未設定時はヘッダーにリンクを出さない）
# MANUAL_PORTAL_URL=
# PlantUML サーバ（未設定時は公開サーバ http://www.plantuml.com/plantuml）
# PLANTUML_SERVER_URL=http://localhost:8080/plantuml
