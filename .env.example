# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# MkDocs サーバー設定
MKDOCS_PORT=8000

# アプリケーション開発サーバー設定（SonarQube 等とポートが競合する場合に変更）
# DEV_APP_PORT=9000

# 開発用 admin シードユーザー（cargo-tracker）。本番では Secrets Manager から注入する
# ADMIN_SEED_ENABLED=true
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Adm1nPass!

# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# DOCKER_HOST=npipe:////./pipe/docker_engine

# SSH 接続設定
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx
