# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# MkDocs サーバー設定
MKDOCS_PORT=8000

# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# DOCKER_HOST=npipe:////./pipe/docker_engine

# PostgreSQL 設定（apps/docker-compose.yml で使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MULTIPLE_DATABASES=auth_db,booking_read_db,routing_read_db,tracking_read_db,handling_read_db,billing_read_db

# SSH 接続設定
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx

# Kubernetes 運用設定（ops/scripts/k8s.js で使用、すべて任意。未設定時は既定値）
# K8S_NAMESPACE=cargo-tracker
# K8S_CLUSTER_TYPE=minikube
# K8S_KIND_CLUSTER=cargo-tracker
# K8S_IMAGE_PREFIX=cargo-tracker
# K8S_IMAGE_TAG=latest
# K8S_HELM_RELEASE=cargo-tracker
