# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# MkDocs サーバー設定
MKDOCS_PORT=8000

# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# DOCKER_HOST=npipe:////./pipe/docker_engine

# SSH 接続設定
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx

# 開発環境（Heroku）デプロイ設定 — docs/operation/開発環境セットアップ手順書.md
DEV_HEROKU_APP_NAME=xxxxxxxx
DEV_DOCKER_PLATFORM=linux/amd64

# ローカル PostgreSQL の公開ポート（他プロジェクトと 5432 が衝突する場合に変更）
# DEV_DB_PORT=5433
