# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env
#
# 注意:
#   - .env は .gitignore に登録済み。秘匿値はコミットしないこと
#   - 暗号化版（.env.vault）を共有する場合は ops/scripts/vault.js の `vault:encrypt` を使用
#   - ADR-0003 によりすべてのシークレットは .env 必須化（ハードコード廃止）

# =========================
# MkDocs サーバー設定
# =========================
MKDOCS_PORT=8000

# =========================
# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# =========================
# DOCKER_HOST=npipe:////./pipe/docker_engine

# =========================
# SSH 接続設定（運用環境ごとに 1 セット）
# =========================
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx

# =========================
# Local 開発: PostgreSQL（apps/docker-compose.yml 用）
# =========================
POSTGRES_USER=cargo
POSTGRES_PASSWORD=__set_a_strong_local_password__
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# =========================
# Local 開発: Axon Server（apps/docker-compose.yml 用）
# =========================
AXON_SERVER_HTTP_PORT=8024
AXON_SERVER_GRPC_PORT=8124
# DEVMODE_ENABLED は **ローカルのみ**。ステージング・本番では false にする
AXONIQ_AXONSERVER_DEVMODE_ENABLED=true

# =========================
# Local 開発: JWT
# =========================
JWT_SECRET=__generate_random_64_bytes_base64__
JWT_ISSUER=case-study-cargo-tracker

# =========================
# Local 開発: SonarQube（ops/scripts/sonar_local.js 用、ADR-0003 で必須化）
# =========================
LOCAL_SONAR_PORT=9000
LOCAL_SONAR_DB_PASSWORD=__set_a_strong_local_password__
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=__generate_in_sonarqube_ui__

# =========================
# GitHub Container Registry（ADR-0003 採用）
# =========================
# CI では GITHUB_TOKEN を使用するため通常 .env での設定は不要
# ローカルから手動で push する場合のみ Personal Access Token を設定（read:packages, write:packages）
# GHCR_USERNAME=your-github-username
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
