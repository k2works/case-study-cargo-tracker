# 本リポジトリで扱わない記事シリーズ
# claude-code-booster の更新時に配布物として復元されるため無視する
# （docs/article は monolith-architecture と functional-domain-modeling のみを扱う）
docs/article/getting-start-tdd/
docs/article/grokkingfp/
docs/article/grokking-concurrency/
docs/article/functional-desgin-ppp/
docs/article/practical-database-design/
docs/article/getting-start-docker-kubernetes/
# 参照元ソースのローカルビルド成果物
docs/article/source/**/.gradle/

# Gradle
.gradle/
apps/backend/**/build/

# SonarQube scanner の作業ディレクトリ
.scannerwork/

# ユーザーマニュアルの HTML（docs/manual から manual:build が生成する）。
# 生成物を追跡すると、ソースと出力の二重管理になる
/apps/www/manual/

# MkDocs の HTML（docs/ から mkdocs:build が生成する）。
# docs/ の Markdown を正とし、ポータル配信用の生成物は追跡しない
/apps/www/docs/

# JIG / jig-erd の HTML・SVG（コードと DB スキーマから生成する）。
# apps/backend/**/build を正とし、ポータル配信用の生成物は追跡しない
/apps/www/jig/
/apps/www/jig-erd/

# E2E の生成物。リポジトリ直下から実行したときにここへ出る
/test-results/
