#!/usr/bin/env bash
# pre-commit フック
# コミット前にバックエンド・フロントエンドの静的解析とテストを実行する。

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
BACKEND_DIR="${REPO_ROOT}/apps/backend"
FRONTEND_DIR="${REPO_ROOT}/apps/frontend"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# ── バックエンド（Java）チェック ──────────────────────────────
STAGED_JAVA=$(echo "${STAGED_FILES}" | grep -E '\.java$' || true)

if [ -n "${STAGED_JAVA}" ]; then
  echo "==> [pre-commit] バックエンド静的解析・テストを実行中..."
  echo "${STAGED_JAVA}" | sed 's/^/    /'
  (
    cd "${BACKEND_DIR}"
    ./gradlew check --daemon --parallel --quiet
  )
  echo "==> [pre-commit] バックエンドチェック通過。"
fi

# ── フロントエンド（TypeScript/TSX）チェック ──────────────────
STAGED_FRONTEND=$(echo "${STAGED_FILES}" | grep -E 'apps/frontend/.*\.(ts|tsx|js|jsx)$' || true)

if [ -n "${STAGED_FRONTEND}" ]; then
  echo "==> [pre-commit] フロントエンド静的解析を実行中..."
  echo "${STAGED_FRONTEND}" | sed 's/^/    /'
  (
    cd "${FRONTEND_DIR}"
    npm run lint -- --max-warnings=0
  )
  echo "==> [pre-commit] フロントエンドチェック通過。"
fi

if [ -z "${STAGED_JAVA}" ] && [ -z "${STAGED_FRONTEND}" ]; then
  echo "==> [pre-commit] チェック対象ファイルなし。スキップします。"
fi

echo "==> [pre-commit] 全チェック通過。コミットを続行します。"
