# EditorConfig: https://editorconfig.org
# C# の規約は dotnet format / .NET Analyzers が参照する
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# CA1716: 名前空間 Shared は設計（architecture_backend.md の共有カーネル）で規定。
# VB との相互運用は想定しないため抑止する
dotnet_diagnostic.CA1716.severity = none

# 名前空間・using
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# var の使用
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# 式形式メンバー・パターンマッチ
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# null 安全
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# 命名規則: プライベートフィールドは _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# インターフェースは I プレフィックス
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

# ============================================
# SonarQube 誤検出の抑制（IT5 品質ゲート・operating-qt）
# ============================================

# Dapper のリポジトリ/ACL/クエリの DTO（Row/HeaderRow/*View 等）は private set・プロパティを
# リフレクション経由で設定するため、SonarQube の「未使用の private set」（S1144）・
# 「未割当メンバー」（S3459）は誤検出となる。Infrastructure 層・QueryServices に限定して抑制する。
[**/Infrastructure/**.cs]
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.S3459.severity = none

[**/QueryServices/**.cs]
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.S3459.severity = none

# テストコードの正規表現ヘルパー（トークン抽出等）は GeneratedRegex 化の価値が低いため
# SYSLIB1045 を抑制する。あわせて DTO 系の指摘も対象外とする。
[**/tests/**.cs]
dotnet_diagnostic.SYSLIB1045.severity = none
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.S3459.severity = none
