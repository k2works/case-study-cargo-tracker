  "type": "module",
  "dependencies": {
    "@k2works/claude-code-booster": "^4.5.0",
    "dotenv": "^17.2.3",
    "gulp": "^5.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
