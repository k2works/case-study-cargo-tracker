{
  "name": "case-study-cargo-tracker",
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "start": "gulp spec",
    "journal": "gulp journal:generate",
    "docs:serve": "gulp mkdocs:serve",
    "docs:stop": "gulp mkdocs:stop",
    "docs:build": "gulp mkdocs:build",
    "manual:build": "gulp manual:build",
    "vault:encrypt": "gulp vault:encrypt",
    "vault:decrypt": "gulp vault:decrypt",
    "vault:view": "gulp vault:view",
    "vault:rekey": "gulp vault:rekey",
    "ac:trace": "node ops/scripts/ac-trace.cjs",
    "backend:dev": "sbt \"local-server/Test/runMain cargotracker.app.E2eServer 8080\"",
    "backend:compile": "sbt compile",
    "backend:test": "sbt test",
    "backend:fmt": "sbt scalafmtAll",
    "backend:fmt:check": "sbt scalafmtCheckAll",
    "backend:schema": "sbt \"local-server/testOnly cargotracker.app.SchemaSnapshotSpec\"",
    "frontend:install": "npm --prefix apps/web install",
    "frontend:dev": "VITE_BACKEND_URL=http://127.0.0.1:8080 VITE_DEV_ROLE=Sales VITE_DEV_USER_ID=01ARZ3NDEKTSV4RRFFQ69G5FAV npm --prefix apps/web run dev",
    "frontend:build": "npm --prefix apps/web run build",
    "frontend:typecheck": "npm --prefix apps/web run typecheck",
    "frontend:lint": "npm --prefix apps/web run lint",
    "frontend:test": "npm --prefix apps/web run test",
    "frontend:codegen": "npm --prefix apps/web run codegen",
    "frontend:e2e": "npm --prefix apps/web run e2e",
    "check": "npm run backend:fmt:check && npm run backend:test && npm run frontend:typecheck && npm run frontend:lint && npm run frontend:test && npm run ac:trace -- US02=AC-01+AC-02,US04=AC-01+AC-02",
    "okf:check": "gulp okf:check",
    "okf:viz": "gulp okf:viz",
    "claude:yolo": "claude --dangerously-skip-permissions",
    "copilot:yolo": "copilot --allow-all-tools",
    "codex:yolo": "codex --yolo",
    "gemini:yolo": "gemini --yolo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2works/case-study-cargo-tracker.git"
  },
  "keywords": [
    "ai",
    "programming",
    "learning"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/k2works/case-study-cargo-tracker/issues"
  },
  "homepage": "https://github.com/k2works/case-study-cargo-tracker#readme",
  "type": "module",
  "dependencies": {
    "@k2works/claude-code-booster": "^6.1.0",
    "dotenv": "^17.2.3",
    "gulp": "^5.0.0",
    "marked": "^18.0.11",
    "plantuml-encoder": "^1.4.0"
  }
}
