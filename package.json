{
  "name": "case-study-cargo-tracker",
  "version": "2.0.0",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "start": "gulp spec",
    "journal": "gulp journal:generate",
    "docs:serve": "gulp mkdocs:serve",
    "docs:stop": "gulp mkdocs:stop",
    "docs:build": "gulp mkdocs:build",
    "manual:build": "gulp manual:build",
    "vault:encrypt": "gulp vault:encrypt",
    "vault:decrypt": "gulp vault:decrypt",
    "vault:view": "gulp vault:view",
    "vault:rekey": "gulp vault:rekey",
    "claude:yolo": "claude --dangerously-skip-permissions",
    "copilot:yolo": "copilot --allow-all-tools",
    "codex:yolo": "codex --yolo",
    "gemini:yolo": "gemini --yolo",
    "app:build": "cd apps/cargo-tracker && ./gradlew build",
    "lint": "cd apps/cargo-tracker && ./gradlew checkstyleMain checkstyleTest spotbugsMain spotbugsTest",
    "test": "cd apps/cargo-tracker && TZ=UTC ./gradlew test",
    "build": "npm run app:build",
    "test:e2e": "npx playwright test",
    "app:test": "cd apps/cargo-tracker && ./gradlew test",
    "app:check": "cd apps/cargo-tracker && ./gradlew check",
    "app:lint": "cd apps/cargo-tracker && ./gradlew checkstyleMain checkstyleTest spotbugsMain",
    "app:start": "cd apps/cargo-tracker && ./gradlew bootRun --args=--spring.profiles.active=local",
    "app:jig": "cd apps/cargo-tracker && ./gradlew jigReports",
    "app:jig-erd": "cd apps/cargo-tracker && ./gradlew jigErd",
    "screenshots:manual": "playwright test --config=playwright.manual.config.js",
    "e2e": "playwright test --config=playwright.config.js",
    "app:watch": "gulp app:watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2works/case-study-cargo-tracker.git"
  },
  "keywords": [
    "ai",
    "programming",
    "learning"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/k2works/case-study-cargo-tracker/issues"
  },
  "homepage": "https://github.com/k2works/case-study-cargo-tracker#readme",
  "type": "module",
  "dependencies": {
    "@k2works/claude-code-booster": "^4.14.0",
    "dotenv": "^17.2.3",
    "gulp": "^5.0.0",
    "marked": "^18.0.9",
    "plantuml-encoder": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
