# Rust ソースに変更がある場合のみ品質チェックを実行する
if git diff --cached --name-only | grep -qE '^apps/cargo-tracker/.*(\.rs|Cargo\.toml)$'; then
  echo "pre-commit: cargo fmt / clippy を実行します"
  (cd apps/cargo-tracker \
    && cargo fmt --all -- --check \
    && cargo clippy --workspace --all-targets -q -- -D warnings)
fi
